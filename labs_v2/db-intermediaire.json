  "check": {
    "type": "config_assertions",
    "rules": [
      {
        "id": "database-engine",
        "description": "Choisir PostgreSQL comme moteur.",
        "device": "DB1",
        "path": "config.workloads.database.engine",
        "operator": "equals",
        "expected": "postgresql"
      },
      {
        "id": "database-replication",
        "description": "Activer la réplication.",
        "device": "DB1",
        "path": "config.workloads.database.replication",
        "operator": "equals",
        "expected": true
      },
      {
        "id": "database-backups",
        "description": "Activer les sauvegardes régulières.",
        "device": "DB1",
        "path": "config.workloads.database.backups",
        "operator": "equals",
        "expected": true
      },
      {
        "id": "database-tls",
        "description": "Activer TLS pour les connexions.",
        "device": "DB1",
        "path": "config.workloads.database.tls",
        "operator": "equals",
        "expected": true
      },
      {
        "id": "database-backup_retention_days",
        "description": "Retenir les sauvegardes pendant 7 jours.",
        "device": "DB1",
        "path": "config.workloads.database.backup_retention_days",
        "operator": "equals",
        "expected": 7
      },
      {
        "id": "database-max_connections",
        "description": "Fixer le maximum à 200 connexions.",
        "device": "DB1",
        "path": "config.workloads.database.max_connections",
        "operator": "equals",
        "expected": 200
      }
    ],
