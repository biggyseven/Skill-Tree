  "check": {
    "type": "config_assertions",
    "pass_threshold": 1,
    "rules": [
      {
        "id": "igw-attached",
        "description": "The VPC has an attached Internet Gateway.",
        "device": "VPC",
        "path": "config.routes[0].igw_attached",
        "operator": "equals",
        "expected": true
      },
      {
        "id": "public-default",
        "description": "The public route table points to the Internet Gateway.",
        "device": "VPC",
        "path": "config.routes[0].route_tables.public_default",
        "operator": "equals",
        "expected": "igw-001"
      },
      {
        "id": "nat-enabled",
        "description": "A NAT Gateway is enabled for private egress.",
        "device": "VPC",
        "path": "config.routes[0].nat_gateway_enabled",
        "operator": "equals",
        "expected": true
      },
      {
        "id": "private-default",
        "description": "The private route table points to the NAT Gateway.",
        "device": "VPC",
        "path": "config.routes[0].route_tables.private_default",
        "operator": "equals",
        "expected": "nat-001"
      },
      {
        "id": "flow-logs",
        "description": "VPC Flow Logs are enabled.",
        "device": "VPC",
        "path": "config.routes[0].flow_logs_enabled",
        "operator": "equals",
        "expected": true
      },
      {
        "id": "private-no-public-ip",
        "description": "Private instances do not have public IPs by default.",
        "device": "VPC",
        "path": "config.routes[0].public_ip_on_private_instances",
        "operator": "equals",
        "expected": false
      }
