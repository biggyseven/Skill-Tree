  "duration_min": 40,
  "difficulty": "expert",
  "prompt": "Concevez une défense multicouche contre une attaque DDoS : filtrage local, limitation de débit, SYN cookies, scrubbing amont et stratégie de blackhole contrôlée.",
  "objectives": [
    "Activer la protection DDoS locale.",
    "Fixer une limite de 100 000 paquets/s.",
    "Activer les SYN cookies.",
    "Activer le scrubbing amont.",
    "Préparer une route de blackhole d’urgence."
  ],
  "hints": [
    "Sur la CLI de FW1, saisissez enable puis configure terminal.",
    "Exécutez : workload security ddos_protection enabled.",
    "Exécutez : workload security rate_limit_pps 100000.",
    "Exécutez : workload security syn_cookies enabled.",
    "Exécutez : workload security upstream_scrubbing enabled.",
    "Exécutez : workload security blackhole_route enabled.",
    "Utilisez show workloads pour relire l’état structuré avant de lancer « Vérifier »."
