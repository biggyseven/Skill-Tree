  "level": "intermédiaire",
  "module": "Cloud Computing",
  "prompt": "Exposez l’application via un ALB, placez les instances derrière un Auto Scaling Group réparti sur plusieurs zones et rendez RDS privé avec des sauvegardes configurées.",
  "objectives": [
    "Activer les health checks du target group.",
    "Activer un ASG avec une capacité minimale de deux instances.",
    "Répartir les instances sur plusieurs zones.",
    "Limiter les flux par Security Groups.",
    "Désactiver l’accès public de RDS et activer les sauvegardes.",
    "Utiliser un profil IAM."
  ],
  "hints": [
    "Les Security Groups limitent les chemins nécessaires.",
    "La base ne doit pas être accessible directement depuis Internet.",
    "La haute disponibilité nécessite plusieurs AZ."
  ],
