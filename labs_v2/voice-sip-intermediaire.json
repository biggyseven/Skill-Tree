  "id": "voice-sip-intermediaire",
  "title": "Protocole SIP — Domaine, dial-peer et QoS",
  "level": "intermédiaire",
  "module": "Voix & Collaboration",
  "duration_min": 25,
  "difficulty": "intermédiaire",
  "prompt": "Préparez un service de téléphonie IP. Définissez le domaine SIP, le dial-peer 2001, un codec compatible, l’enregistrement et un profil QoS pour prioriser la voix.",
  "objectives": [
    "Configurer le domaine SIP voice.skilltree.local.",
    "Déclarer le dial-peer 2001.",
    "Choisir le codec G.711 A-law.",
    "Activer l’enregistrement SIP.",
    "Définir le VLAN voix 30.",
    "Activer le profil QoS voice-priority."
  ],
  "hints": [
    "Sur la CLI de APP1, saisissez enable puis configure terminal.",
    "Exécutez : workload voice sip_domain voice.skilltree.local.",
    "Exécutez : workload voice dial_peer 2001.",
    "Exécutez : workload voice codec g711alaw.",
    "Exécutez : workload voice registration enabled.",
    "Exécutez : workload voice voice_vlan 30.",
    "Exécutez : workload voice qos_profile voice-priority.",
    "Utilisez show workloads pour relire l’état structuré avant de lancer « Vérifier »."
  ],
