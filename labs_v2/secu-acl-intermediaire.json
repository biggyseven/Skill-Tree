{
  "id": "secu-acl-intermediaire",
  "title": "ACL étendue — Bloquer un attaquant",
  "level": "intermediaire",
  "module": "Cybersécurité",
  "prompt": "Configurez une ACL étendue sur R1 pour bloquer le trafic du PC Attaquant vers le Serveur, tout en autorisant le reste du trafic. L'ACL doit être numérotée 100 et appliquée sur l'interface Fa0/0 en entrée.",
  "objectives": [
    "Créer une ACL étendue numérotée 100 sur R1.",
    "Refuser le trafic IP depuis 192.168.1.10 vers le serveur 10.0.0.5.",
    "Autoriser le reste du trafic avec permit ip any any.",
    "Appliquer l'ACL 100 sur Fa0/0 en entrée."
  ],
  "hints": [
    "Les ACL Cisco sont évaluées de haut en bas ; la première règle correspondante s'applique.",
    "Ajoutez le deny spécifique avant permit ip any any.",
    "Sur IOS : access-list 100 deny ip host 192.168.1.10 host 10.0.0.5 puis access-list 100 permit ip any any.",
    "Appliquez avec interface Fa0/0 puis ip access-group 100 in."
  ],
  "duration_min": 20,
  "difficulty": "intermediaire",
  "xp_reward": 100,
  "badges": [
    "first_blood"
  ],
  "schema_version": 2,
  "definition_json": {
    "schema_version": 2,
    "initial_topology": {
      "nodes": [
        {
          "id": "R1",
          "type": "router",
          "label": "R1",
          "x": 360,
          "y": 150,
          "config": {}
        },
        {
          "id": "SW1",
          "type": "switch",
          "label": "SW1",
          "x": 360,
          "y": 290,
          "config": {}
        },
        {
          "id": "attaquant",
          "type": "pc",
          "label": "Attaquant",
          "x": 120,
          "y": 420,
          "config": {
            "ip": "192.168.1.10",
            "mask": "255.255.255.0"
          }
        },
        {
          "id": "protege",
          "type": "server",
          "label": "Protégé",
          "x": 600,
          "y": 420,
          "config": {
            "ip": "10.0.0.5",
            "mask": "255.255.255.0"
          }
        }
      ],
      "edges": [
        {
          "id": "e1",
          "source": "R1",
          "target": "SW1",
          "source_port": "Fa0/0",
          "target_port": "Fa0/1"
        },
        {
          "id": "e2",
          "source": "SW1",
          "target": "attaquant",
          "source_port": "Fa0/2",
          "target_port": "eth0"
        },
        {
          "id": "e3",
          "source": "SW1",
          "target": "protege",
          "source_port": "Fa0/3",
          "target_port": "eth0"
        }
      ]
    },
    "checks": [
      {
        "id": "acl_100_exists",
        "description": "R1 possède une ACL numérotée 100",
        "target": "R1",
        "field": "acls.100",
        "operator": "exists",
        "expected": true
      },
      {
        "id": "deny_attacker",
        "description": "L’ACL 100 bloque le trafic de l’attaquant",
        "target": "R1",
        "field": "acls.100",
        "operator": "contains",
        "expected": "deny ip host 192.168.1.10 host 10.0.0.5"
      },
      {
        "id": "permit_rest",
        "description": "L’ACL 100 autorise le reste du trafic",
        "target": "R1",
        "field": "acls.100",
        "operator": "contains",
        "expected": "permit ip any any"
      },
      {
        "id": "applied_inbound",
        "description": "L’ACL 100 est appliquée en entrée sur Fa0/0",
        "target": "R1",
        "field": "interfaces.Fa0/0.access_group_in",
        "operator": "equals",
        "expected": "100"
      }
    ]
  }
}
