  "check": {
    "type": "config_assertions",
    "rules": [
      {
        "id": "r1_dhcp_network",
        "description": "Le pool DHCP de R1 doit distribuer le réseau 192.168.1.0/24",
        "device": "R1",
        "path": "config.services.dhcp.network",
        "operator": "equals",
        "expected": "192.168.1.0/24"
      },
      {
        "id": "r1_dhcp_pool_name",
        "description": "Le pool DHCP doit être nommé LAN-CLIENTS",
        "device": "R1",
        "path": "config.services.dhcp.pool_name",
        "operator": "equals",
        "expected": "LAN-CLIENTS"
      },
      {
        "id": "r1_dhcp_gateway",
        "description": "Le pool DHCP doit annoncer la passerelle 192.168.1.1",
        "device": "R1",
        "path": "config.services.dhcp.default_router",
        "operator": "equals",
        "expected": "192.168.1.1"
      },
      {
        "id": "r1_dhcp_dns",
        "description": "Le pool DHCP doit annoncer un serveur DNS",
        "device": "R1",
        "path": "config.services.dhcp.dns_server",
        "operator": "exists",
        "expected": true
      },
      {
        "id": "r1_inside_ip",
        "description": "R1 Fa0/0 doit être adressée en 192.168.1.1",
        "device": "R1",
        "path": "ports[0].ip",
        "operator": "equals",
        "expected": "192.168.1.1"
      },
      {
        "id": "r1_inside_mask",
        "description": "R1 Fa0/0 doit utiliser le masque 255.255.255.0",
        "device": "R1",
        "path": "ports[0].mask",
        "operator": "equals",
        "expected": "255.255.255.0"
      },
      {
        "id": "sw1_pc1_access",
        "description": "SW1 Fa0/1 doit être en mode access",
        "device": "SW1",
        "path": "ports[0].mode",
        "operator": "equals",
        "expected": "access"
      },
      {
        "id": "sw1_pc2_access",
        "description": "SW1 Fa0/2 doit être en mode access",
        "device": "SW1",
        "path": "ports[1].mode",
        "operator": "equals",
        "expected": "access"
      }
    ],
    "pass_threshold": 1,
    "time_bonus": {
      "under_15min": 10,
      "under_30min": 5
    }
  },
  "xp_reward": 50,
  "badges": [
