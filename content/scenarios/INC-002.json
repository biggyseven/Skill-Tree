  "diagnostic_steps": [
    {
      "title": "Qualifier le défaut",
      "instructions": "Vérifiez l'adresse IP, la passerelle et le serveur DNS de PC1. Distinguez une panne IP d'une panne de résolution de nom.",
      "hint": "Une adresse statique correcte ne garantit pas que le DNS possède l'enregistrement demandé."
    },
    {
      "title": "Inspecter le DNS simulé",
      "instructions": "Sur R1, inspectez show running-config puis ajoutez ip host portail.intra.skilltree.local 10.10.10.53.",
      "hint": "La commande ip host ajoute un nom et une adresse à la configuration DNS simulée."
    },
    {
      "title": "Valider la correction",
      "instructions": "Vérifiez que la base DNS de R1 contient le nom demandé puis relancez la validation du ticket.",
      "hint": "Conservez l'adressage de PC1 ; corrigez l'enregistrement sur R1."
    }
