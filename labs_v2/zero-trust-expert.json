{
  "schema_version": 2,
  "id": "zero-trust-expert",
  "title": "Zero Trust expert — Microsegmentation et SIEM",
  "level": "expert",
  "module": "Architecture Zero Trust",
  "prompt": "Mettez en place une politique Zero Trust entre les couches utilisateur, application, API et base. Exigez identité, MFA et conformité du terminal, refusez les flux non prévus et envoyez les décisions au SIEM.",
  "objectives": [
    "Appliquer le refus par défaut.",
    "Autoriser uniquement les flux nécessaires entre couches.",
    "Bloquer l’accès utilisateur direct à la base.",
    "Exiger identité, MFA et posture terminal.",
    "Exporter les événements de sécurité vers le SIEM."
  ],
  "hints": [
    "La microsegmentation décrit les flux par application et par service.",
    "Le serveur de base doit recevoir les connexions uniquement depuis l’API.",
    "La télémétrie doit être activée pour permettre l’investigation."
  ],
  "duration_min": 40,
  "difficulty": "expert",
