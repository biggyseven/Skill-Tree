  "check": {
    "type": "config_assertions",
    "pass_threshold": 1,
    "rules": [
      {
        "id": "allow-web-action",
        "description": "La règle Web autorise le trafic demandé.",
        "device": "FW1",
        "path": "config.acls[0].rules[0].action",
        "operator": "equals",
        "expected": "accept"
      },
      {
        "id": "allow-web-port",
        "description": "La règle Web cible le port TCP 80 du serveur.",
        "device": "FW1",
        "path": "config.acls[0].rules[0].destination_port",
        "operator": "equals",
        "expected": 80
      },
      {
        "id": "allow-web-protocol",
        "description": "Le protocole de la règle Web est TCP.",
        "device": "FW1",
        "path": "config.acls[0].rules[0].protocol",
        "operator": "equals",
        "expected": "tcp"
      },
      {
        "id": "allow-web-destination",
        "description": "La règle Web cible le bon serveur interne.",
        "device": "FW1",
        "path": "config.acls[0].rules[0].destination",
        "operator": "equals",
