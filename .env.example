# Copie ce fichier vers .env uniquement pour le développement local.
# Ne commite jamais de clés réelles ni de mots de passe.

# Authentification du site public (requise sur Render).
# Génère le hash localement : python scripts/generate_auth_password_hash.py
# Génère un secret de session fort : python -c "import secrets; print(secrets.token_urlsafe(48))"
# Configure les deux valeurs dans l'environnement Render, jamais dans Git.
SKILLTREE_AUTH_PASSWORD_HASH=
SKILLTREE_AUTH_SECRET=
# En local, l'auth se déclenche si l'une des deux valeurs ci-dessus est renseignée.
# Sur Render, l'API est verrouillée par défaut si ces valeurs manquent.

# Clé API Groq : https://console.groq.com/keys
GROQ_API_KEY=

# Modèle du tuteur IA (facultatif)
# GROQ_MODEL=openai/gpt-oss-120b

# Nom affiché sur le certificat (facultatif)
CERTIFICATE_NAME=

# Origines web externes autorisées pour les appels API cross-origin (liste séparée par des virgules).
# Laisser vide pour n'autoriser que l'usage same-origin (recommandé pour l'interface intégrée).
# SKILLTREE_CORS_ORIGINS=https://mon-frontend.example,https://admin.example

# Ancien moteur de labs Docker interactifs (shell arbitraire, réservé aux environnements de confiance).
# Laisser désactivé sur tout site public ; utiliser Lab Workspace v2 en production.
# SKILLTREE_ENABLE_LEGACY_DOCKER_LABS=true

# URL PostgreSQL Neon : à configurer dans les variables d’environnement Render.
# DATABASE_URL=
# URL directe facultative pour les migrations ; ne pas la commiter.
# DATABASE_URL_UNPOOLED=

# Autres clés d’intégration (facultatives)
OPENROUTER_API_KEY=
