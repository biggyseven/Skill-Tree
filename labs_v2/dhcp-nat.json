  "check": {
    "type": "config_assertions",
    "rules": [
      {
        "id": "r1_dhcp_pool",
        "description": "Le pool LAN-CLIENTS contient le réseau, le masque, la passerelle, le DNS et le bail attendus.",
        "device": "R1",
        "path": "config.protocols.dhcp.pools",
        "operator": "contains",
        "expected": {
          "name": "LAN-CLIENTS",
          "network": "192.168.1.0",
          "mask": "255.255.255.0",
          "default_router": "192.168.1.1",
          "dns_server": "192.168.1.53",
          "lease_days": 7
        }
      },
      {
        "id": "r1_inside_ip",
        "description": "R1 Fa0/0 utilise l’adresse IPv4 192.168.1.1.",
        "device": "R1",
        "path": "ports[0].ip",
        "operator": "equals",
        "expected": "192.168.1.1"
      },
      {
        "id": "r1_inside_mask",
        "description": "R1 Fa0/0 utilise le masque 255.255.255.0.",
        "device": "R1",
        "path": "ports[0].mask",
        "operator": "equals",
        "expected": "255.255.255.0"
      },
      {
        "id": "sw1_pc1_access",
        "description": "SW1 Fa0/1 est configuré en mode access.",
        "device": "SW1",
        "path": "ports[0].mode",
        "operator": "equals",
        "expected": "access"
      },
      {
        "id": "sw1_pc2_access",
        "description": "SW1 Fa0/2 est configuré en mode access.",
        "device": "SW1",
        "path": "ports[1].mode",
        "operator": "equals",
        "expected": "access"
      },
      {
        "id": "r1_dhcp_exclusion",
        "description": "Les adresses 192.168.1.1 à 192.168.1.20 sont exclues du pool DHCP.",
        "device": "R1",
        "path": "config.protocols.dhcp.excluded_addresses",
        "operator": "contains",
        "expected": {
          "start": "192.168.1.1",
          "end": "192.168.1.20"
        }
      },
      {
        "id": "r1_nat_acl",
        "description": "L’ACL 1 sélectionne les sources du réseau 192.168.1.0/24 pour le NAT.",
        "device": "R1",
        "path": "config.acls",
        "operator": "contains",
        "expected": "1 permit 192.168.1.0 0.0.0.255"
      },
      {
        "id": "r1_nat_inside",
        "description": "Fa0/0 est marquée NAT inside.",
        "device": "R1",
        "path": "ports[0].nat_role",
        "operator": "equals",
        "expected": "inside"
      },
      {
        "id": "r1_nat_outside",
        "description": "Fa0/1 est marquée NAT outside.",
        "device": "R1",
        "path": "ports[1].nat_role",
        "operator": "equals",
        "expected": "outside"
      },
      {
        "id": "r1_nat_overload",
        "description": "NAT overload utilise l’ACL 1 et l’interface extérieure Fa0/1.",
        "device": "R1",
        "path": "config.protocols.nat",
        "operator": "equals",
        "expected": {
          "acl_number": 1,
          "outside_interface": "Fa0/1",
          "overload": true
        }
      }
    ],
