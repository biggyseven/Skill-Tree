  "id": "zero-trust-intermediaire",
  "title": "Zero Trust — Identité, MFA et refus par défaut",
  "level": "intermédiaire",
  "module": "Architecture Zero Trust",
  "prompt": "Appliquez une première politique Zero Trust : le client accède à l’application en HTTPS uniquement après vérification d’identité et MFA ; l’accès direct à la base est refusé et les décisions sont journalisées.",
  "objectives": [
    "Remplacer l’autorisation générale par un refus par défaut.",
    "Autoriser explicitement HTTPS vers l’application.",
    "Exiger identité et MFA.",
    "Refuser le client direct vers la base.",
    "Activer la journalisation."
  ],
  "hints": [
    "Zero Trust vérifie chaque accès, pas seulement la présence sur le LAN.",
    "Autorisez le flux précis nécessaire et refusez les autres flux.",
    "La base ne doit accepter que les connexions de la couche applicative."
  ],
  "duration_min": 30,
