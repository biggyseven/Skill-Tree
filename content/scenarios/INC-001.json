  "diagnostic_steps": [
    {
      "title": "Qualifier l'impact",
      "instructions": "Confirmez quels postes sont touchés et vérifiez si le serveur ERP est toujours joignable depuis le VLAN attendu.",
      "hint": "Comparez PC1 avec PC3/PC4 : le défaut est localisé à un port ou à un segment."
    },
    {
      "title": "Examiner les ports d'accès",
      "instructions": "Inspectez la configuration VLAN des ports de SW1 et SW2, notamment Fa0/7.",
      "hint": "Un port d'accès doit appartenir au VLAN correspondant au poste."
    },
    {
      "title": "Corriger et vérifier",
      "instructions": "Configurez SW1 Fa0/7 dans le VLAN 20 puis vérifiez la configuration et la connectivité.",
      "hint": "Ne modifiez ni le trunk inter-switch ni les autres ports."
    }
  ],
