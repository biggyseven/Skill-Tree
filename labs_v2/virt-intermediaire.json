  "title": "Virtualisation avancée — Hôte et migration",
  "level": "intermédiaire",
  "module": "Administration Système",
  "duration_min": 30,
  "difficulty": "intermédiaire",
  "prompt": "Préparez un hôte de virtualisation pour des charges de production. Choisissez KVM, désactivez le surengagement mémoire, activez la migration à chaud et définissez le bridge et le pool de stockage.",
  "objectives": [
    "Choisir KVM comme hyperviseur.",
    "Désactiver le surengagement.",
    "Activer la migration à chaud.",
    "Raccorder les VM au bridge br0.",
    "Utiliser le pool fast-ssd."
  ],
  "hints": [
    "Sur la CLI de APP1, saisissez enable puis configure terminal.",
    "Exécutez : workload virtualization hypervisor kvm.",
    "Exécutez : workload virtualization overcommit disabled.",
    "Exécutez : workload virtualization live_migration enabled.",
    "Exécutez : workload virtualization network_bridge br0.",
    "Exécutez : workload virtualization storage_pool fast-ssd.",
    "Utilisez show workloads pour relire l’état structuré avant de lancer « Vérifier »."
  ],
