  "diagnostic_steps": [
    {
      "title": "Comparer l'adressage",
      "instructions": "Inspectez l'adresse et le masque de PC1 et PC2 avec show ip interface brief ou show interfaces eth0.",
      "hint": "Le masque détermine le réseau local même si les adresses semblent proches."
    },
    {
      "title": "Corriger PC2",
      "instructions": "Sur PC2, ouvrez interface eth0 et appliquez ip address 192.168.50.200 255.255.255.0.",
      "hint": "Conservez l'adresse et la passerelle ; seul le masque est erroné."
    },
    {
      "title": "Vérifier la cohérence",
      "instructions": "Comparez à nouveau les masques des deux postes puis testez la connectivité.",
      "hint": "Les deux postes doivent utiliser le préfixe /24."
    }
  ],
  "resolution_check": {
    "type": "config_assertions",
    "rules": [
      {
        "target": "PC2",
        "path": "ports.eth0.mask",
        "operator": "equals",
        "value": "255.255.255.0",
        "description": "PC2 doit utiliser le masque /24 comme PC1."
      }
    ]
  },
