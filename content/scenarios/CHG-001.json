        "target": "R1",
        "path": "config.acls",
        "operator": "contains",
        "value": "permit tcp any host 10.0.0.5 eq 443",
        "description": "L'ACL de R1 doit contenir la règle d'autorisation TCP/443 vers 10.0.0.5."
      }
    ]
  },
