{
  "schema_version": 2,
  "id": "nat-debutant",
  "title": "NAT & PAT — Publier la sortie Internet d’un LAN",
  "level": "débutant",
  "module": "Administration Réseaux",
  "duration_min": 20,
  "difficulty": "débutant",
  "prompt": "Configurez le NAT/PAT sur R1 afin que le LAN 192.168.10.0/24 accède au réseau opérateur avec l’adresse WAN du routeur. Fa0/0 est l’interface LAN et Gig0/1 l’interface WAN.",
  "objectives": [
    "Activer le NAT sortant et la surcharge PAT.",
    "Déclarer les interfaces inside/outside sans les inverser.",
    "Appliquer le NAT au réseau 192.168.10.0/24.",
    "Vérifier la politique NAT avant le test de connectivité."
  ],
  "hints": [
    "Le LAN doit utiliser Fa0/0 et le réseau opérateur Gig0/1.",
    "La surcharge PAT partage l’adresse de l’interface WAN entre les hôtes internes.",
    "Le NAT ne remplace pas la route par défaut."
  ],
