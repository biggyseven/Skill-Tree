  "diagnostic_steps": [
    {
      "title": "Lire le CPU",
      "instructions": "Sur SW1, exécutez show processes cpu puis inspectez les journaux dans show running-config.",
      "hint": "Une charge CPU très élevée associée à une tempête de broadcast est un indice de boucle L2."
    },
    {
      "title": "Identifier la boucle",
      "instructions": "Repérez la liaison SW1 Fa0/2–Fa0/3 et vérifiez le mode STP.",
      "hint": "La boucle doit être neutralisée sans couper le port utilisateur."
    },
    {
      "title": "Rétablir la protection L2",
      "instructions": "Sur SW1, exécutez spanning-tree mode rapid-pvst puis relancez la vérification. Consignez la cause dans le RCA.",
      "hint": "Expliquez comment la boucle/broadcast a saturé le plan de contrôle."
    }
  ],
  "resolution_check": {
    "type": "config_assertions",
    "rules": [
      {
        "target": "SW1",
        "path": "config.protocols.stp.enabled",
        "operator": "equals",
        "value": true,
        "description": "STP doit être activé sur SW1."
      },
      {
        "target": "SW1",
        "path": "config.protocols.stp.mode",
        "operator": "equals",
        "value": "rapid-pvst",
        "description": "SW1 doit fonctionner en Rapid PVST+."
      },
      {
        "type": "post_mortem_contains",
        "field": "root_cause",
        "any_of": [
          "boucle",
          "broadcast",
          "STP"
        ],
        "description": "Le RCA doit expliquer la boucle L2 ou la tempête de broadcast."
      }
    ]
  },
