    "rules": [
      {
        "id": "vip",
        "description": "HSRP uses the agreed virtual gateway.",
        "device": "R1",
        "path": "config.routes[0].virtual_ip",
        "operator": "equals",
        "expected": "192.168.10.254"
      },
      {
        "id": "priority",
        "description": "R1 is the preferred active gateway.",
        "device": "R1",
        "path": "config.routes[0].priority",
        "operator": "equals",
        "expected": 110
      },
      {
        "id": "preempt",
        "description": "R1 can resume active role after recovery.",
        "device": "R1",
        "path": "config.routes[0].preempt",
        "operator": "equals",
        "expected": true
      },
      {
        "id": "track-interface",
        "description": "R1 tracks its uplink.",
        "device": "R1",
        "path": "config.routes[0].track_interface",
        "operator": "equals",
        "expected": "Gi0/1"
      },
      {
        "id": "decrement",
        "description": "Tracked failure lowers priority by 30.",
        "device": "R1",
        "path": "config.routes[0].decrement",
        "operator": "equals",
        "expected": 30
      },
      {
        "id": "standby-priority",
        "description": "R2 is the standby gateway.",
        "device": "R2",
        "path": "config.routes[0].priority",
        "operator": "equals",
        "expected": 100
      },
