      "expected_acl": 101,
      "actual_acl": null,
      "detail": "L'ACL n'est pas appliquée en entrée sur l'interface côté PC-Admin."
    }
  ],
  "diagnostic_steps": [
    {
      "title": "Définir le périmètre",
      "instructions": "Confirmez les adresses PC-Admin et SRV-DB. Le flux permis est TCP source 192.168.10.10, destination 10.0.0.50, port 3306.",
      "hint": "La règle permit doit être précise, puis le trafic restant vers SRV-DB doit être bloqué."
    },
    {
      "title": "Créer l'ACL",
      "instructions": "Sur R1, ajoutez access-list 101 permit tcp host 192.168.10.10 host 10.0.0.50 eq 3306 puis access-list 101 deny ip any host 10.0.0.50.",
      "hint": "N'utilisez pas any comme source dans la règle permit."
    },
    {
      "title": "Appliquer et contrôler",
      "instructions": "Sur R1, entrez dans interface Fa0/1 et appliquez ip access-group 101 in. Vérifiez show running-config.",
      "hint": "L'ACL doit être appliquée à l'interface où le trafic admin entre sur R1."
    }
  ],
  "resolution_check": {
    "type": "config_assertions",
    "rules": [
      {
        "target": "R1",
        "path": "config.acls",
        "operator": "contains",
        "value": "101 permit tcp host 192.168.10.10 host 10.0.0.50 eq 3306",
        "description": "Autoriser le flux TCP/3306 demandé."
      },
      {
        "target": "R1",
        "path": "config.acls",
        "operator": "contains",
        "value": "101 deny ip any host 10.0.0.50",
        "description": "Refuser les autres flux IP vers SRV-DB."
      },
      {
        "target": "R1",
        "path": "ports.Fa0/1.access_group_in",
        "operator": "equals",
        "value": 101,
        "description": "Appliquer l'ACL 101 en entrée sur Fa0/1."
      }
    ]
  },
