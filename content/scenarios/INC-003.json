    {
      "id": "F1",
      "device": "R1",
      "area": "dhcp",
      "expected": "USERS /24, router 192.168.20.1, DNS 192.168.20.53",
      "actual": "service disabled; pool /25; router/DNS incorrect",
      "detail": "Le service DHCP est désactivé et le pool distribue des paramètres incohérents."
    }
  ],
  "diagnostic_steps": [
    {
      "title": "Vérifier l'étendue",
      "instructions": "Comparez les postes affectés puis inspectez le pool DHCP de R1 avec show running-config.",
      "hint": "Deux postes touchés simultanément orientent vers le service DHCP partagé."
    },
    {
      "title": "Réactiver et corriger le pool",
      "instructions": "En configuration globale, exécutez service dhcp puis ip dhcp pool USERS. Configurez network 192.168.20.0 255.255.255.0, default-router 192.168.20.1 et dns-server 192.168.20.53.",
      "hint": "Le réseau, le masque, la passerelle et le DNS doivent correspondre au plan d'adressage."
    },
    {
      "title": "Contrôler la configuration",
      "instructions": "Vérifiez les paramètres du pool USERS dans show running-config, puis relancez le contrôle du ticket.",
      "hint": "La validation exige le service actif et les bons paramètres."
    }
  ],
  "resolution_check": {
    "type": "config_assertions",
    "rules": [
      {
        "target": "R1",
        "path": "config.dhcp_enabled",
        "operator": "equals",
        "value": true,
        "description": "Le service DHCP de R1 doit être activé."
      },
      {
        "target": "R1",
        "path": "config.protocols.dhcp.pools",
        "operator": "contains",
        "value": "255.255.255.0",
        "description": "Le pool USERS doit distribuer le masque /24."
      },
      {
        "target": "R1",
        "path": "config.protocols.dhcp.pools",
        "operator": "contains",
        "value": "192.168.20.1",
        "description": "Le pool USERS doit distribuer la passerelle correcte."
      },
      {
        "target": "R1",
        "path": "config.protocols.dhcp.pools",
        "operator": "contains",
        "value": "192.168.20.53",
        "description": "Le pool USERS doit distribuer le DNS correct."
      }
    ]
  },
