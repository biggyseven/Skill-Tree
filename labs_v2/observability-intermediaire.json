  "title": "Observabilité — Collecte, alertes et tableaux de bord",
  "level": "intermédiaire",
  "module": "DevOps",
  "duration_min": 30,
  "difficulty": "intermédiaire",
  "prompt": "Déployez une base d’observabilité exploitable. Déclarez Prometheus et Grafana, fixez l’intervalle de collecte, créez une règle d’alerte et un tableau de bord avec rétention des données.",
  "objectives": [
    "Choisir Prometheus-Grafana.",
    "Collecter les métriques toutes les 15 secondes.",
    "Déclarer la règle cpu-high.",
    "Créer le tableau node-overview.",
    "Retenir les données pendant 15 jours."
  ],
  "hints": [
    "Sur la CLI de APP1, saisissez enable puis configure terminal.",
    "Exécutez : workload monitoring stack prometheus-grafana.",
    "Exécutez : workload monitoring scrape_interval_seconds 15.",
    "Exécutez : workload monitoring alert_rule cpu-high.",
    "Exécutez : workload monitoring dashboard node-overview.",
    "Exécutez : workload monitoring retention_days 15.",
    "Utilisez show workloads pour relire l’état structuré avant de lancer « Vérifier »."
  ],
