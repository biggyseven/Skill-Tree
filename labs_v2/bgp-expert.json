  "check": {
    "type": "config_assertions",
    "pass_threshold": 1,
    "rules": [
      {
        "id": "rr-client",
        "description": "R2 configure R3 comme client du route reflector.",
        "device": "R2",
        "path": "config.routes[0].route_reflector_client",
        "operator": "equals",
        "expected": true
      },
      {
        "id": "rr-source",
        "description": "La session iBGP utilise une source Loopback0 stable.",
        "device": "R2",
        "path": "config.routes[0].update_source",
        "operator": "equals",
        "expected": "Loopback0"
      },
      {
        "id": "rr-next-hop",
        "description": "La politique next-hop-self est explicite.",
        "device": "R2",
        "path": "config.routes[0].next_hop_self",
        "operator": "equals",
        "expected": true
      },
      {
        "id": "rr-auth",
        "description": "L’authentification de la session est configurée.",
        "device": "R2",
        "path": "config.routes[0].password_configured",
        "operator": "equals",
        "expected": true
      },
      {
        "id": "rr-graceful",
        "description": "La reprise BGP gracieuse est activée.",
        "device": "R2",
        "path": "config.routes[0].graceful_restart",
        "operator": "equals",
        "expected": true
      },
      {
        "id": "rr-local-as",
        "description": "Le route reflector utilise l’AS interne 65002.",
        "device": "R2",
        "path": "config.routes[0].local_as",
        "operator": "equals",
        "expected": 65002
      }
    ],
