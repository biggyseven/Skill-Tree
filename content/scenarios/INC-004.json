    {
      "id": "F1",
      "device": "SW1/SW2/SW3",
      "area": "layer2",
      "detail": "Le triangle L2 est actif sans STP et les broadcasts peuvent tourner en boucle."
    },
    {
      "id": "F2",
      "device": "SW1/SW2/SW3",
      "area": "stp",
      "expected": "rapid-pvst",
      "actual": "STP disabled",
      "detail": "Le spanning-tree est désactivé dans la configuration de départ."
    }
  ],
  "diagnostic_steps": [
    {
      "title": "Corréler les alertes",
      "instructions": "Comparez les pertes de supervision, les compteurs CPU et les logs de broadcast.",
      "hint": "Une topologie redondante n'est pas une panne en soi : le défaut est l'absence de prévention de boucle."
    },
    {
      "title": "Inspecter STP",
      "instructions": "Sur chaque commutateur, inspectez show running-config et comparez les configurations L2.",
      "hint": "STP doit fonctionner sur tous les commutateurs du domaine de broadcast."
    },
    {
      "title": "Activer STP",
      "instructions": "Sur SW1, SW2 et SW3, entrez en configuration globale et exécutez spanning-tree mode rapid-pvst.",
      "hint": "Appliquez la correction aux trois commutateurs sans supprimer la redondance."
    }
  ],
  "resolution_check": {
    "type": "config_assertions",
    "rules": [
      {
        "target": "SW1",
        "path": "config.protocols.stp.enabled",
        "operator": "equals",
        "value": true,
        "description": "SW1 doit avoir STP activé."
      },
      {
        "target": "SW1",
        "path": "config.protocols.stp.mode",
        "operator": "equals",
        "value": "rapid-pvst",
        "description": "SW1 doit fonctionner en Rapid PVST+."
      },
      {
        "target": "SW2",
        "path": "config.protocols.stp.enabled",
        "operator": "equals",
        "value": true,
        "description": "SW2 doit avoir STP activé."
      },
      {
        "target": "SW2",
        "path": "config.protocols.stp.mode",
        "operator": "equals",
        "value": "rapid-pvst",
        "description": "SW2 doit fonctionner en Rapid PVST+."
      },
      {
        "target": "SW3",
        "path": "config.protocols.stp.enabled",
        "operator": "equals",
        "value": true,
        "description": "SW3 doit avoir STP activé."
      },
      {
        "target": "SW3",
        "path": "config.protocols.stp.mode",
        "operator": "equals",
        "value": "rapid-pvst",
        "description": "SW3 doit fonctionner en Rapid PVST+."
      }
    ]
  },
