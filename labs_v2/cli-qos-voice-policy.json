    "rules": [
      {
        "id": "qos_policy",
        "description": "Contrôle serveur : qos policy doit être conforme.",
        "device": "R1",
        "path": "config.protocols.qos.policy_maps[0].name",
        "operator": "equals",
        "expected": "VOICE-POLICY"
      },
      {
        "id": "qos_voice_class",
        "description": "Contrôle serveur : qos voice class doit être conforme.",
        "device": "R1",
        "path": "config.protocols.qos.policy_maps[0].classes[0].name",
        "operator": "equals",
        "expected": "VOICE"
      },
      {
        "id": "qos_priority",
        "description": "Contrôle serveur : qos priority doit être conforme.",
        "device": "R1",
        "path": "config.protocols.qos.policy_maps[0].classes[0].priority_percent",
        "operator": "equals",
        "expected": 20
      },
      {
        "id": "qos_applied",
        "description": "Contrôle serveur : qos applied doit être conforme.",
        "device": "R1",
        "path": "ports[0].service_policy_out",
