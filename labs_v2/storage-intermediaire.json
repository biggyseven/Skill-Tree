  "level": "intermédiaire",
  "module": "Administration Système",
  "duration_min": 30,
  "difficulty": "intermédiaire",
  "prompt": "Concevez le stockage du serveur de données. Créez le groupe de volumes et le volume logique attendus, utilisez RAID 10, activez les snapshots et le chiffrement puis définissez le point de montage.",
  "objectives": [
    "Nommer le groupe de volumes vg_data.",
    "Créer le volume logique lv_db.",
    "Choisir RAID 10.",
    "Activer les snapshots.",
    "Définir le point de montage /srv/data.",
    "Activer le chiffrement."
  ],
  "hints": [
    "Sur la CLI de DB1, saisissez enable puis configure terminal.",
    "Exécutez : workload storage volume_group vg_data.",
    "Exécutez : workload storage logical_volume lv_db.",
    "Exécutez : workload storage raid_level 10.",
    "Exécutez : workload storage snapshot enabled.",
    "Exécutez : workload storage mountpoint /srv/data.",
    "Exécutez : workload storage encryption enabled.",
    "Utilisez show workloads pour relire l’état structuré avant de lancer « Vérifier »."
  ],
