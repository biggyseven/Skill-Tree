  "title": "VRF — Instancier une VRF client sur les PE",
  "level": "intermédiaire",
  "module": "Administration Réseaux",
  "prompt": "Configurez une VRF CLIENT-A sur les routeurs PE1 et PE2. Définissez les RD/RT, associez le port client à la VRF et empêchez les tables de routage des clients de se mélanger.",
  "objectives": [
    "Créer la VRF CLIENT-A sur les deux PE.",
    "Définir un RD distinct par PE.",
    "Configurer les route-targets import/export compatibles.",
    "Associer l’interface d’accès client à la VRF."
  ],
  "hints": [
    "Le RD identifie une route VPN ; les RT gouvernent import/export.",
    "Les RD peuvent être distincts alors que les RT du même client sont compatibles.",
    "Une interface client ne doit appartenir qu’à la VRF voulue."
  ],
  "duration_min": 30,
  "difficulty": "intermédiaire",
