  "check": {
    "type": "config_assertions",
    "rules": [
      {
        "id": "sw1_vlan10",
        "description": "SW1 doit déclarer VLAN 10 nommé VLAN10",
        "device": "SW1",
        "path": "config.vlans",
        "operator": "contains",
        "expected": {
          "id": 10,
          "name": "VLAN10"
        }
      },
      {
        "id": "sw2_vlan10",
        "description": "SW2 doit déclarer VLAN 10 nommé VLAN10",
        "device": "SW2",
        "path": "config.vlans",
        "operator": "contains",
        "expected": {
          "id": 10,
          "name": "VLAN10"
        }
      },
      {
        "id": "sw1_access_mode",
        "description": "SW1 Fa0/1 doit être en mode access",
        "device": "SW1",
        "path": "ports[0].mode",
        "operator": "equals",
        "expected": "access"
      },
      {
        "id": "sw1_access_vlan",
        "description": "SW1 Fa0/1 doit appartenir au VLAN 10",
        "device": "SW1",
        "path": "ports[0].vlan",
        "operator": "equals",
        "expected": 10
      },
      {
        "id": "sw2_access_mode",
        "description": "SW2 Fa0/1 doit être en mode access",
        "device": "SW2",
        "path": "ports[0].mode",
        "operator": "equals",
        "expected": "access"
      },
      {
        "id": "sw2_access_vlan",
        "description": "SW2 Fa0/1 doit appartenir au VLAN 10",
        "device": "SW2",
        "path": "ports[0].vlan",
        "operator": "equals",
        "expected": 10
      },
      {
        "id": "sw1_trunk",
        "description": "SW1 Fa0/24 doit être en mode trunk",
        "device": "SW1",
        "path": "ports[1].mode",
        "operator": "equals",
        "expected": "trunk"
      },
      {
        "id": "sw2_trunk",
        "description": "SW2 Fa0/24 doit être en mode trunk",
        "device": "SW2",
        "path": "ports[1].mode",
        "operator": "equals",
        "expected": "trunk"
      }
    ],
