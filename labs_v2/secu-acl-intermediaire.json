{
  "schema_version": 2,
  "id": "secu-acl-intermediaire",
  "title": "ACL étendue — Bloquer un attaquant",
  "level": "intermediaire",
  "module": "Cybersécurité",
  "duration_min": 20,
  "difficulty": "intermediaire",
  "prompt": "Configurez une ACL étendue sur R1 pour bloquer le trafic du PC Attaquant vers le Serveur, tout en autorisant le reste du trafic. L'ACL doit être numérotée 100 et appliquée sur l'interface Fa0/0 en entrée.",
  "objectives": [
    "Créer une ACL étendue numérotée 100 sur R1.",
    "Refuser le trafic IP depuis 192.168.1.10 vers 10.0.0.5.",
    "Autoriser le reste du trafic avec permit ip any any.",
    "Appliquer l'ACL 100 sur Fa0/0 en entrée."
  ],
  "hints": [
    "Les ACL Cisco sont évaluées de haut en bas.",
    "Ajoutez le deny spécifique avant permit ip any any.",
    "Utilisez access-list 100 deny ip host 192.168.1.10 host 10.0.0.5 puis access-list 100 permit ip any any.",
    "Appliquez l’ACL avec ip access-group 100 in sur Fa0/0."
  ],
  "initial_topology": {
    "schema_version": 2,
    "topology_id": "secu-acl-topology",
    "metadata": {
      "name": "ACL étendue — filtrage du trafic",
      "author": "Skill-Tree",
      "mode": "lab"
    },
    "nodes": [
      {
        "id": "R1",
        "type": "router",
        "model": "Cisco IOS",
        "x": 360,
        "y": 140,
        "label": "R1",
        "ports": [
          {
            "id": "Fa0/0",
            "name": "Fa0/0",
            "state": "up",
            "mode": "routed",
            "ip": "192.168.1.1",
            "mask": "255.255.255.0"
          },
          {
            "id": "Fa0/1",
            "name": "Fa0/1",
            "state": "up",
            "mode": "routed",
            "ip": "10.0.0.1",
            "mask": "255.255.255.0"
          }
        ],
        "config": {
          "hostname": "R1",
          "acls": []
        }
      },
      {
        "id": "SW1",
        "type": "switch",
        "model": "Layer 2",
        "x": 360,
        "y": 300,
        "label": "SW1",
        "ports": [
          {
            "id": "Fa0/1",
            "name": "Fa0/1",
            "state": "up",
            "mode": "access"
          },
          {
            "id": "Fa0/2",
            "name": "Fa0/2",
            "state": "up",
            "mode": "access"
          }
        ],
        "config": {
          "hostname": "SW1"
        }
      },
      {
        "id": "attaquant",
        "type": "pc",
        "model": "PC",
        "x": 120,
