    "type": "config_assertions",
    "rules": [
      {
        "id": "web-reverse_proxy",
        "description": "Choisir Nginx comme reverse proxy.",
        "device": "APP1",
        "path": "config.workloads.web.reverse_proxy",
        "operator": "equals",
        "expected": "nginx"
      },
      {
        "id": "web-tls",
        "description": "Activer TLS.",
        "device": "APP1",
        "path": "config.workloads.web.tls",
        "operator": "equals",
        "expected": true
      },
      {
        "id": "web-healthcheck",
        "description": "Activer le health check.",
        "device": "APP1",
        "path": "config.workloads.web.healthcheck",
        "operator": "equals",
        "expected": true
      },
      {
        "id": "web-backend_pool",
        "description": "Déclarer APP1 et APP2 comme backends.",
        "device": "APP1",
        "path": "config.workloads.web.backend_pool",
        "operator": "equals",
        "expected": "APP1,APP2"
      },
      {
        "id": "web-listen_port",
        "description": "Écouter sur le port 443.",
        "device": "APP1",
        "path": "config.workloads.web.listen_port",
        "operator": "equals",
        "expected": 443
      },
      {
        "id": "web-sticky_sessions",
        "description": "Désactiver l’affinité de session.",
        "device": "APP1",
        "path": "config.workloads.web.sticky_sessions",
        "operator": "equals",
        "expected": false
