  "hidden_faults": [
    {
      "id": "F1",
      "device": "R1/R2",
      "interface": "Fa0/1",
      "expected": "full/full",
      "actual": "R1 full, R2 half",
      "detail": "Le mismatch half/full duplex peut provoquer collisions, retransmissions et pertes de paquets."
    }
  ],
  "diagnostic_steps": [
    {
      "title": "Mesurer et localiser",
      "instructions": "Répétez les pings entre sites et inspectez les interfaces de R1 et R2.",
      "hint": "Une perte localisée sur le lien inter-routeurs oriente vers la couche 1/2."
    },
    {
      "title": "Comparer le duplex",
      "instructions": "Utilisez show interfaces Fa0/1 sur R1 et R2 puis comparez les paramètres.",
      "hint": "Les deux extrémités doivent utiliser un duplex cohérent."
    },
    {
      "title": "Corriger et documenter",
      "instructions": "Sur R2, configurez interface Fa0/1 puis duplex full. Vérifiez R1 et complétez le RCA en expliquant le mismatch.",
      "hint": "Le RCA doit nommer le mismatch et la correction doit laisser les deux côtés en full-duplex."
    }
  ],
  "resolution_check": {
    "type": "config_assertions",
    "rules": [
      {
        "target": "R1",
        "path": "ports.Fa0/1.duplex",
        "operator": "equals",
        "value": "full",
        "description": "R1 Fa0/1 doit être full-duplex."
      },
      {
        "target": "R2",
        "path": "ports.Fa0/1.duplex",
        "operator": "equals",
        "value": "full",
        "description": "R2 Fa0/1 doit être full-duplex."
      },
      {
        "type": "post_mortem_contains",
        "field": "root_cause",
        "any_of": [
          "duplex",
          "négociation"
        ],
        "description": "Le RCA doit identifier le mismatch de duplex."
      }
    ]
  },
