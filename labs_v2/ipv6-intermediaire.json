  "id": "ipv6-intermediaire",
  "title": "IPv6 — Routage statique entre deux LAN",
  "level": "intermédiaire",
  "module": "Administration Réseaux",
  "prompt": "Rétablissez la connectivité IPv6 entre 2001:db8:10::/64 et 2001:db8:20::/64. Les interfaces sont adressées, mais les routes statiques et les next-hops sont incorrects.",
  "objectives": [
    "Vérifier l’adressage IPv6.",
    "Ajouter une route vers le LAN distant sur chaque routeur.",
    "Utiliser le voisin du lien de transit comme next-hop.",
    "Valider le chemin aller et le chemin retour."
  ],
  "hints": [
    "Les réseaux directement connectés ne suffisent pas pour joindre le LAN distant.",
    "Le next-hop doit être l’adresse IPv6 du routeur voisin.",
    "Une route aller sans route de retour ne garantit pas la connectivité."
  ],
  "duration_min": 25,
  "difficulty": "intermédiaire",
