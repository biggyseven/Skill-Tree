  "title": "AWS VPC expert — Multi-AZ, Transit Gateway et endpoints",
  "level": "expert",
  "module": "Cloud Computing",
  "prompt": "Durcissez un VPC multi-AZ : attachez le Transit Gateway, activez Flow Logs et la propagation de routes, configurez un endpoint S3 et répartissez les NAT Gateways par zone. La base doit rester privée, chiffrée et sauvegardée.",
  "objectives": [
    "Déployer les workloads dans plusieurs AZ.",
    "Attacher le Transit Gateway et propager les routes.",
    "Créer un endpoint privé S3.",
    "Désactiver les IP publiques sur les ressources privées.",
    "Activer chiffrement et sauvegardes de la base."
  ],
  "hints": [
    "Les endpoints réduisent les sorties Internet pour les services pris en charge.",
    "Les tables de routage doivent être observables.",
    "La haute disponibilité exige une répartition réelle par AZ."
  ],
  "duration_min": 40,
  "difficulty": "expert",
