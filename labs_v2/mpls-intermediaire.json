  "level": "intermédiaire",
  "module": "Administration Réseaux",
  "prompt": "Activez MPLS/LDP sur PE1, P1 et PE2. Définissez un LSR ID et une adresse de transport stables, choisissez la distribution de labels attendue et synchronisez la disponibilité LDP avec l’IGP.",
  "objectives": [
    "Activer LDP sur les routeurs concernés.",
    "Utiliser une loopback comme identifiant stable.",
    "Configurer la distribution de labels.",
    "Activer la synchronisation LDP/IGP."
  ],
  "hints": [
    "LDP a besoin d’une connectivité IP entre les LSR.",
    "Un LSR ID stable ne doit pas être une adresse d’interface temporaire.",
    "La synchronisation IGP évite de router le trafic vers un voisin dont les labels ne sont pas prêts."
  ],
  "duration_min": 30,
