          "name": "VLAN10"
        }
      },
      {
        "id": "stp_mode",
        "description": "SW1 utilise Rapid-PVST.",
        "device": "SW1",
        "path": "config.protocols.stp.mode",
        "operator": "equals",
        "expected": "rapid-pvst"
      },
      {
        "id": "stp_root",
        "description": "SW1 est configuré comme racine primaire du VLAN 10.",
        "device": "SW1",
        "path": "config.protocols.stp.roots",
        "operator": "contains",
        "expected": {
          "vlan": 10,
          "role": "primary"
        }
      },
      {
        "id": "stp_portfast",
        "description": "PortFast est activé sur Fa0/1.",
        "device": "SW1",
        "path": "ports[0].spanning_tree.portfast",
