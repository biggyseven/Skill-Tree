    {
      "title": "Vérifier la demande",
      "instructions": "Confirmez la destination 10.0.0.5, le protocole TCP et le port 443.",
      "hint": "L'autorisation doit être aussi étroite que possible."
    },
    {
      "title": "Ajouter la règle ACL",
      "instructions": "Sur R1, ajoutez exactement « permit tcp any host 10.0.0.5 eq 443 » dans config.acls sans supprimer les règles existantes.",
      "hint": "Respectez la destination et le port précisés dans la RFC."
    },
    {
      "title": "Contrôler le changement",
      "instructions": "Inspectez la configuration ACL finale et vérifiez que la règle demandée est présente.",
      "hint": "Une règle plus large ne respecte pas le périmètre du changement."
    }
