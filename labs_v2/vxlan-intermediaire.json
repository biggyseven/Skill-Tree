  "check": {
    "type": "config_assertions",
    "pass_threshold": 1,
    "rules": [
      {
        "id": "vxlan-enabled",
        "description": "VXLAN is enabled on LEAF1.",
        "device": "LEAF1",
        "path": "config.routes[0].enabled",
        "operator": "equals",
        "expected": true
      },
      {
        "id": "vni",
        "description": "The VNI matches VLAN 10.",
        "device": "LEAF1",
        "path": "config.routes[0].vni",
        "operator": "equals",
        "expected": 10010
      },
      {
        "id": "local-vtep",
        "description": "LEAF1 uses its stable VTEP address.",
        "device": "LEAF1",
        "path": "config.routes[0].local_vtep",
        "operator": "equals",
        "expected": "10.255.0.1"
      },
      {
        "id": "remote-vtep",
        "description": "LEAF1 knows the remote VTEP.",
        "device": "LEAF1",
        "path": "config.routes[0].remote_vteps",
        "operator": "contains",
        "expected": "10.255.0.2"
      },
      {
        "id": "udp-port",
        "description": "VXLAN uses UDP/4789.",
        "device": "LEAF1",
        "path": "config.routes[0].udp_port",
        "operator": "equals",
        "expected": 4789
      },
      {
        "id": "mapping",
        "description": "VLAN 10 maps to VNI 10010.",
        "device": "LEAF1",
        "path": "config.routes[0].vlan_to_vni",
        "operator": "contains",
        "expected": {
          "vlan": 10,
          "vni": 10010
        }
      },
      {
        "id": "underlay",
        "description": "The underlay route to the remote VTEP is reachable.",
        "device": "LEAF1",
        "path": "config.routes[0].underlay_reachable",
        "operator": "equals",
        "expected": true
      }
    ],
