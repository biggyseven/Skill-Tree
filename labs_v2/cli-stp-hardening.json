        "operator": "equals",
        "expected": "rapid-pvst"
      },
      {
        "id": "stp_root",
        "description": "Contrôle serveur : stp root doit être conforme.",
        "device": "SW1",
        "path": "config.protocols.stp.roots",
        "operator": "contains",
        "expected": {
          "vlan": 10,
          "role": "primary"
        }
      },
      {
        "id": "stp_portfast",
        "description": "Contrôle serveur : stp portfast doit être conforme.",
