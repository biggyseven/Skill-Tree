  "diagnostic_steps": [
    {
      "title": "Lire l'indicateur CPU",
      "instructions": "Sur R1, exécutez show processes cpu pour relever la charge CPU. Inspectez ensuite SW1 et les logs de broadcast signalés sur Fa0/2 et Fa0/3.",
      "hint": "La charge CPU du routeur est le symptôme ; la boucle de commutation sur SW1 est la cause à isoler."
    },
    {
      "title": "Identifier la boucle",
      "instructions": "Repérez la liaison SW1 Fa0/2–Fa0/3 et vérifiez que le spanning-tree est désactivé sur SW1.",
      "hint": "Une boucle de couche 2 sans STP peut inonder le segment de broadcasts et perturber les équipements connectés."
    },
    {
      "title": "Rétablir la protection L2",
      "instructions": "Sur SW1, exécutez spanning-tree mode rapid-pvst puis relancez la vérification. Consignez la cause dans le RCA.",
      "hint": "Expliquez comment la boucle/broadcast a saturé le plan de contrôle."
    }
  ],
  "resolution_check": {
    "type": "config_assertions",
    "rules": [
      {
        "target": "SW1",
        "path": "config.protocols.stp.enabled",
        "operator": "equals",
        "value": true,
        "description": "STP doit être activé sur SW1."
      },
      {
        "target": "SW1",
        "path": "config.protocols.stp.mode",
        "operator": "equals",
        "value": "rapid-pvst",
        "description": "SW1 doit fonctionner en Rapid PVST+."
      },
      {
        "type": "post_mortem_contains",
        "field": "root_cause",
        "any_of": [
          "boucle",
          "broadcast",
          "STP"
        ],
        "description": "Le RCA doit expliquer la boucle L2 ou la tempête de broadcast."
      }
    ]
  },
