        "device": "PE1",
        "path": "config.routes[0].vpn.rd",
        "operator": "equals",
        "expected": "65000:101"
      },
      {
        "id": "rt-import",
        "description": "Le RT import est défini.",
        "device": "PE1",
        "path": "config.routes[0].vpn.rt_import",
