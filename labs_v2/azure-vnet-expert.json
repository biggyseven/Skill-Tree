  "title": "Azure VNet expert — Hub/spoke, Firewall et Private Link",
  "level": "expert",
  "module": "Cloud Computing",
  "prompt": "Finalisez une architecture Azure hub/spoke. Forcez le trafic par Azure Firewall à l’aide des UDR, autorisez le trafic transféré au peering et publiez la base exclusivement via Private Link et DNS privé.",
  "objectives": [
    "Activer le peering hub/spoke.",
    "Forcer le trafic nord-sud vers Azure Firewall.",
    "Activer les journaux Network Watcher.",
    "Créer un Private Endpoint pour la base.",
    "Lier le DNS privé et supprimer l’exposition publique."
  ],
  "hints": [
    "Le peering ne rend pas automatiquement le routage transitif.",
    "Private Link réduit l’exposition publique du service.",
    "Le DNS privé doit renvoyer l’adresse privée du service."
  ],
  "duration_min": 40,
