  "check": {
    "type": "config_assertions",
    "rules": [
      {
        "id": "sw1_vlan10",
        "description": "SW1 doit créer VLAN 10 nommé VLAN10",
        "device": "SW1",
        "path": "config.vlans",
        "operator": "contains",
        "expected": {
          "id": 10,
          "name": "VLAN10"
        }
      },
      {
        "id": "sw1_vlan20",
        "description": "SW1 doit créer VLAN 20 nommé VLAN20",
        "device": "SW1",
        "path": "config.vlans",
        "operator": "contains",
        "expected": {
          "id": 20,
          "name": "VLAN20"
        }
      },
      {
        "id": "sw1_pc1_access",
        "description": "SW1 Fa0/1 doit être en mode access",
        "device": "SW1",
        "path": "ports[0].mode",
        "operator": "equals",
        "expected": "access"
      },
      {
        "id": "sw1_pc1_vlan10",
        "description": "SW1 Fa0/1 doit appartenir au VLAN 10",
        "device": "SW1",
        "path": "ports[0].vlan",
        "operator": "equals",
        "expected": 10
      },
      {
        "id": "sw1_pc2_access",
        "description": "SW1 Fa0/2 doit être en mode access",
        "device": "SW1",
        "path": "ports[1].mode",
        "operator": "equals",
        "expected": "access"
      },
      {
        "id": "sw1_pc2_vlan20",
        "description": "SW1 Fa0/2 doit appartenir au VLAN 20",
        "device": "SW1",
        "path": "ports[1].vlan",
        "operator": "equals",
        "expected": 20
      },
      {
        "id": "sw1_router_trunk",
        "description": "SW1 Fa0/24 doit être en mode trunk",
        "device": "SW1",
        "path": "ports[2].mode",
        "operator": "equals",
        "expected": "trunk"
      },
      {
        "id": "r1_vlan10_ip",
        "description": "R1 Fa0/0.10 doit avoir la passerelle 192.168.10.1",
        "device": "R1",
        "path": "ports[1].ip",
        "operator": "equals",
        "expected": "192.168.10.1"
      },
      {
        "id": "r1_vlan10_mask",
        "description": "R1 Fa0/0.10 doit utiliser le masque /24",
        "device": "R1",
        "path": "ports[1].mask",
        "operator": "equals",
        "expected": "255.255.255.0"
      },
      {
        "id": "r1_vlan20_ip",
        "description": "R1 Fa0/0.20 doit avoir la passerelle 192.168.20.1",
        "device": "R1",
        "path": "ports[2].ip",
        "operator": "equals",
        "expected": "192.168.20.1"
      },
      {
        "id": "r1_vlan20_mask",
        "description": "R1 Fa0/0.20 doit utiliser le masque /24",
        "device": "R1",
        "path": "ports[2].mask",
        "operator": "equals",
        "expected": "255.255.255.0"
      }
    ],
    "pass_threshold": 1,
