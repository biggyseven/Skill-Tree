  "diagnostic_steps": [
    {
      "title": "Préparer le changement",
      "instructions": "Vérifiez le plan d'adressage : VLAN 30 utilise 192.168.30.0/24 avec passerelle 192.168.30.1.",
      "hint": "Le port d'accès, le trunk et la sous-interface doivent s'accorder sur VLAN 30."
    },
    {
      "title": "Configurer SW1",
      "instructions": "Créez vlan 30, configurez interface Fa0/1 puis switchport mode trunk. Configurez ensuite interface Fa0/5, switchport mode access et switchport access vlan 30.",
      "hint": "Fa0/1 relie R1 ; Fa0/5 est le port utilisateur destiné au nouveau VLAN."
    },
    {
      "title": "Configurer R1",
      "instructions": "Sur R1, ouvrez interface Fa0/0.30, puis configurez encapsulation dot1q 30, ip address 192.168.30.1 255.255.255.0 et no shutdown.",
      "hint": "La sous-interface doit utiliser le tag VLAN attendu et la passerelle du sous-réseau."
    }
  ],
  "resolution_check": {
    "type": "config_assertions",
    "rules": [
      {
        "target": "SW1",
        "path": "config.vlans",
        "operator": "contains",
        "value": "VLAN30",
        "description": "VLAN 30 doit exister sur SW1."
      },
      {
        "target": "SW1",
        "path": "ports.Fa0/1.mode",
        "operator": "equals",
        "value": "trunk",
        "description": "Le lien SW1 Fa0/1 vers R1 doit être en trunk."
      },
      {
        "target": "SW1",
        "path": "ports.Fa0/5.vlan",
        "operator": "equals",
        "value": 30,
        "description": "Fa0/5 doit appartenir au VLAN 30."
      },
      {
        "target": "R1",
        "path": "config.subinterfaces.VLAN30.encapsulation",
        "operator": "equals",
        "value": 30,
        "description": "Fa0/0.30 doit utiliser dot1Q 30."
      },
      {
        "target": "R1",
        "path": "config.subinterfaces.VLAN30.ip",
        "operator": "equals",
        "value": "192.168.30.1",
        "description": "La passerelle doit être 192.168.30.1."
      },
      {
        "target": "R1",
        "path": "config.subinterfaces.VLAN30.mask",
        "operator": "equals",
        "value": "255.255.255.0",
        "description": "La sous-interface doit utiliser le masque /24."
      }
    ]
  },
