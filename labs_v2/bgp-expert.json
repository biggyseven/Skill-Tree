  "schema_version": 2,
  "id": "bgp-expert",
  "title": "BGP expert — Route reflector et reprise",
  "level": "expert",
  "module": "Administration Réseaux",
  "prompt": "Durcissez l’AS 65002. Configurez R2 comme route reflector pour R3, stabilisez la source de session avec Loopback0, activez l’authentification et graceful restart, puis vérifiez les voisins de bordure.",
  "objectives": [
    "Configurer le client route reflector iBGP.",
    "Utiliser une source de session stable.",
    "Activer l’authentification des voisins.",
    "Activer la reprise gracieuse."
  ],
  "hints": [
    "Le route reflector et son client sont dans le même AS iBGP.",
    "Loopback0 évite de dépendre uniquement d’une interface physique.",
    "Ne placez jamais le secret de session dans un fichier de scénario."
  ],
  "duration_min": 35,
  "difficulty": "expert",
