        "label": "Attaquant",
        "ports": [
          {
            "id": "eth0",
            "name": "eth0",
            "state": "up",
            "mode": "down",
            "ip": "192.168.1.10",
            "mask": "255.255.255.0"
          }
        ],
        "config": {
          "hostname": "Attaquant"
        }
      },
      {
        "id": "protege",
        "type": "server",
        "model": "Server",
        "x": 600,
        "y": 440,
        "label": "Protégé",
        "ports": [
          {
            "id": "eth0",
            "name": "eth0",
            "state": "up",
            "mode": "down",
            "ip": "10.0.0.5",
            "mask": "255.255.255.0"
          }
        ],
        "config": {
          "hostname": "Protege"
        }
      }
    ],
    "links": [
      {
        "id": "link-r1-sw1",
        "from": {
          "node": "R1",
          "port": "Fa0/0"
        },
        "to": {
          "node": "SW1",
          "port": "Fa0/1"
        },
        "cable_type": "copper_straight",
        "state": "up"
      },
      {
        "id": "link-sw1-attacker",
        "from": {
          "node": "SW1",
          "port": "Fa0/2"
        },
        "to": {
          "node": "attaquant",
          "port": "eth0"
        },
        "cable_type": "copper_straight",
        "state": "up"
      },
      {
        "id": "link-r1-server",
        "from": {
          "node": "R1",
          "port": "Fa0/1"
        },
        "to": {
          "node": "protege",
          "port": "eth0"
        },
        "cable_type": "copper_straight",
        "state": "up"
      }
    ],
    "simulation": {
      "state": "idle",
      "event_log": []
    }
  },
  "check": {
    "type": "config_assertions",
    "pass_threshold": 1,
    "rules": [
      {
        "id": "acl100-deny-attacker",
        "description": "R1 contient une règle ACL 100 deny pour l’IP de l’attaquant vers le serveur",
        "device": "R1",
        "path": "config.acls",
        "operator": "contains",
        "expected": "deny ip host 192.168.1.10 host 10.0.0.5"
      },
      {
        "id": "acl100-permit-rest",
        "description": "R1 contient permit ip any any dans l’ACL 100",
        "device": "R1",
        "path": "config.acls",
        "operator": "contains",
        "expected": "permit ip any any"
      },
      {
        "id": "acl100-number",
        "description": "L’ACL est numérotée 100",
        "device": "R1",
        "path": "config.acls",
        "operator": "contains",
        "expected": "100"
      }
    ]
