  "title": "Administration de bases de données — Haute disponibilité",
  "level": "intermédiaire",
  "module": "Administration Système",
  "duration_min": 30,
  "difficulty": "intermédiaire",
  "prompt": "Préparez le serveur de base de données de production. Sélectionnez PostgreSQL, activez la réplication et les sauvegardes, forcez TLS et définissez des limites de connexions raisonnables.",
  "objectives": [
    "Choisir PostgreSQL comme moteur.",
    "Activer la réplication.",
    "Activer les sauvegardes régulières.",
    "Activer TLS pour les connexions.",
    "Retenir les sauvegardes pendant 7 jours.",
    "Fixer le maximum à 200 connexions."
  ],
  "hints": [
    "Sur la CLI de DB1, saisissez enable puis configure terminal.",
    "Exécutez : workload database engine postgresql.",
    "Exécutez : workload database replication enabled.",
    "Exécutez : workload database backups enabled.",
    "Exécutez : workload database tls enabled.",
    "Exécutez : workload database backup_retention_days 7.",
    "Exécutez : workload database max_connections 200.",
    "Utilisez show workloads pour relire l’état structuré avant de lancer « Vérifier »."
  ],
